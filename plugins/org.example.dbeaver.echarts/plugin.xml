<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension point="org.eclipse.ui.commands">
      <command id="org.example.dbeaver.echarts.launcher" name="BeaverCanvas" description="Create dashboards and reports without running an SQL query">
         <commandParameter id="org.example.dbeaver.echarts.launcher.mode" name="Open" optional="true"/>
      </command>
   </extension>
   <extension point="org.eclipse.ui.handlers">
      <handler commandId="org.example.dbeaver.echarts.launcher" class="org.example.dbeaver.echarts.BeaverCanvasLauncher"/>
   </extension>
   <extension point="org.eclipse.ui.menus">
      <menuContribution locationURI="toolbar:org.eclipse.ui.trim.vertical2?after=additions">
         <toolbar id="org.example.dbeaver.echarts.launcher.toolbar" label="BeaverCanvas">
            <command commandId="org.example.dbeaver.echarts.launcher" id="org.example.dbeaver.echarts.launcher.menu"
                  label="BeaverCanvas" tooltip="BeaverCanvas dashboards and reports" icon="web/assets/beavercanvas-24.png" style="pulldown"/>
         </toolbar>
      </menuContribution>
      <menuContribution locationURI="menu:org.example.dbeaver.echarts.launcher.menu">
         <command commandId="org.example.dbeaver.echarts.launcher" label="New dashboard" icon="web/assets/beavercanvas-16.png"/>
         <command commandId="org.example.dbeaver.echarts.launcher" label="Open dashboard…"><parameter name="org.example.dbeaver.echarts.launcher.mode" value="openDashboard"/></command>
         <separator name="reports" visible="true"/>
         <command commandId="org.example.dbeaver.echarts.launcher" label="Report Designer"><parameter name="org.example.dbeaver.echarts.launcher.mode" value="report"/></command>
         <command commandId="org.example.dbeaver.echarts.launcher" label="Open report…"><parameter name="org.example.dbeaver.echarts.launcher.mode" value="openReport"/></command>
      </menuContribution>
      <menuContribution locationURI="menu:window?before=additions">
         <menu id="org.example.dbeaver.echarts.window.menu" label="BeaverCanvas" icon="web/assets/beavercanvas-16.png">
            <command commandId="org.example.dbeaver.echarts.launcher" label="New dashboard"/>
            <command commandId="org.example.dbeaver.echarts.launcher" label="Report Designer"><parameter name="org.example.dbeaver.echarts.launcher.mode" value="report"/></command>
         </menu>
      </menuContribution>
   </extension>
   <extension point="org.eclipse.core.contenttype.contentTypes">
      <content-type id="org.example.dbeaver.echarts.report" name="BeaverCanvas report template"
            base-type="org.eclipse.core.runtime.text" file-extensions="json" priority="high" default-charset="UTF-8"
            describer="org.example.dbeaver.echarts.ReportContentDescriber"/>
      <content-type id="org.example.dbeaver.echarts.dashboard" name="BeaverCanvas dashboard"
            base-type="org.eclipse.core.runtime.text" file-extensions="json" priority="high" default-charset="UTF-8"
            describer="org.example.dbeaver.echarts.DashboardContentDescriber"/>
   </extension>
   <extension point="org.eclipse.ui.editors">
      <editor id="org.example.dbeaver.echarts.reportEditor" name="Report Designer"
            class="org.example.dbeaver.echarts.ReportEditor" icon="web/assets/beavercanvas-16.png" default="true">
         <contentTypeBinding contentTypeId="org.example.dbeaver.echarts.report"/>
      </editor>
      <editor id="org.example.dbeaver.echarts.dashboardEditor" name="BeaverCanvas dashboard"
            class="org.example.dbeaver.echarts.DashboardEditor" icon="web/assets/beavercanvas-16.png" default="true">
         <contentTypeBinding contentTypeId="org.example.dbeaver.echarts.dashboard"/>
      </editor>
   </extension>
   <extension point="org.jkiss.dbeaver.resourceType">
      <type id="echarts-report" name="Report templates" icon="web/assets/beavercanvas-16.png" folderIcon="web/assets/beavercanvas-16.png" managable="true">
         <root folder="Reports/ECharts"/>
         <contentTypeBinding contentTypeId="org.example.dbeaver.echarts.report"/>
      </type>
      <type id="echarts-dashboard" name="BeaverCanvas dashboard" icon="web/assets/beavercanvas-16.png"
            folderIcon="web/assets/beavercanvas-16.png" managable="true">
         <root folder="Dashboards/ECharts"/>
         <contentTypeBinding contentTypeId="org.example.dbeaver.echarts.dashboard"/>
      </type>
   </extension>
   <extension point="org.jkiss.dbeaver.resourceHandler">
      <handler type="echarts-report" class="org.example.dbeaver.echarts.ReportResourceHandler"/>
      <handler type="echarts-dashboard" class="org.example.dbeaver.echarts.DashboardResourceHandler"/>
   </extension>
   <extension point="org.eclipse.ui.views">
      <category id="org.example.dbeaver.echarts.views" name="BeaverCanvas"/>
      <view id="org.example.dbeaver.echarts.reportDesigner" name="Report Designer" category="org.example.dbeaver.echarts.views"
            class="org.example.dbeaver.echarts.ReportDesignerView" icon="web/assets/beavercanvas-16.png" restorable="true"/>
   </extension>
   <extension point="org.jkiss.dbeaver.resultset.presentation">
      <!-- Keep the optional chart presentation after DBeaver's built-in views. -->
      <presentation
            class="org.example.dbeaver.echarts.EChartsPresentation"
            id="resultset.echarts"
            label="BeaverCanvas"
            icon="web/assets/beavercanvas-16.png"
            type="custom"
            supportsRecordMode="false"
            supportsPanels="false"
            supportsNavigation="false"
            supportsEdit="false"
            supportsHints="false"
            order="1000">
         <objectType name="org.jkiss.dbeaver.model.exec.DBCResultSet"/>
      </presentation>
   </extension>
   <extension point="org.eclipse.ui.preferencePages">
      <page
            id="org.example.dbeaver.echarts.preferences"
            name="BeaverCanvas"
            class="org.example.dbeaver.echarts.EChartsPreferencePage"/>
   </extension>
</plugin>
